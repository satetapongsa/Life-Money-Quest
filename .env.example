# Copy to .env.local for local dev. On Vercel set these in Project Settings → Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Long random string used to hash visitor IPs for rate limiting (raw IPs are never stored)
IP_HASH_SALT=
# Password for the /admin page (leave empty to disable admin)
ADMIN_PASSWORD=
